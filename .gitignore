# ── 日志 ──
*.log

# ── LLM 调用日志（大量 JSON，非源码）──
llm_logs/

# ── 游戏数据库（含 API Key 与个人记忆，严禁上传）──
data/

# ── 个人数据（聊天导出 / 事件日志，开源前必须排除）──
你与*的对话/
*的事件日志/

# ── 本机私有配置（私有服务地址/可执行文件路径，模板见 local_config.example.py）──
backend/local_config.py

# ── Python ──
__pycache__/
*.pyc
.pytest_cache/
.env
.venv/
venv/
myenv/
newenv/
newenv.bak/

# ── 项目自带运行时与离线依赖包（体积大，不入库）──
runtime/
wheels/

# ── 生成的媒体（肖像 / 语音样本 / 生图输出）──
frontend/static/avatars/
frontend/static/voice_samples/
frontend/static/images/generated/
plugins/portrait_lab/outputs/
